{
  "followup_keywords": [
    "from above",
    "from earlier",
    "previous",
    "refine",
    "based on previous",
    "what about",
    "more info",
    "further",
    "from the above",
    "above"

  ],
  "transforms": {
    "count_to_detail": {
      "trigger_patterns": [
        "how many",
        "count",
        "number of"
      ],
      "replacement": {
        "regex": "SELECT\\s+COUNT\\(\\*\\)(\\s+AS\\s+\\w+)?",
        "replace_with": "SELECT *"
      }
    },
    "sum_to_detail": {
      "trigger_patterns": [
        "sum of",
        "total"
      ],
      "replacement": {
        "regex": "SELECT\\s+SUM\\(\\w+\\)(\\s+AS\\s+\\w+)?",
        "replace_with": "SELECT *"
      }
    }
  }
}